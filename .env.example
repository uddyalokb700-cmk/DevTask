# Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration
# In local development without DATABASE_URL, defaults to SQLite.
# For PostgreSQL (Docker or Managed Cloud PostgreSQL):
# DATABASE_URL=postgresql://devtask_user:devtask_password@localhost:5432/devtask_db
DATABASE_URL=

# Redis & Channels (Optional / Real-time)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Security & Cookies (Production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
