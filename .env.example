# DevTask Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# ==========================================
# Core Django Settings
# ==========================================
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==========================================
# Database Configuration
# ==========================================
# Leave empty for local SQLite (db.sqlite3):
# DATABASE_URL=
# For PostgreSQL (Docker Compose, AWS RDS, Neon, Supabase):
DATABASE_URL=postgresql://devtask_user:devtask_secret@localhost:5432/devtask_db

# ==========================================
# Redis & Channels (Real-Time WebSockets)
# ==========================================
# Leave empty for InMemoryChannelLayer in simple local dev:
# REDIS_URL=
# For multi-worker Daphne / production deployments:
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Production HTTPS & Cookie Security
# ==========================================
# Set these to True when serving over HTTPS behind Nginx / Cloudflare
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=31536000

# ==========================================
# Docker Compose Credentials (Optional)
# ==========================================
POSTGRES_DB=devtask_db
POSTGRES_USER=devtask_user
POSTGRES_PASSWORD=devtask_secret
